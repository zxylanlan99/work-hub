# StudyMind V2.0 — environment template
# Copy to `.env` and adjust:  cp .env.example .env

# ---- Postgres (data-service record source) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studymind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Qdrant (vector store) ----
QDRANT_URL=http://qdrant:6333

# ---- Service URLs (host machine) ----
DATA_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_URL=http://localhost:8001
KB_SERVICE_URL=http://localhost:8002
CRAWLER_SERVICE_URL=http://localhost:8003

# ---- Web ----
WEB_PORT=5173

# ---- LLM (Wave 2: T03 / T05) ----
# Used by agent-service / crawler-service / kb-service.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# ---- FastGPT (kb-service / reembed_v1.py, C3: 仅检索后端) ----
FASTGPT_API_URL=http://fastgpt:3000
FASTGPT_API_KEY=
# 开发期无 FastGPT 时回退向量库：chroma | fastgpt（仅 dev 用，生产必须配 FastGPT）
DEV_VECTOR_STORE=fastgpt

# ---- V1.x 迁移凭证 (T17: migrate_v1.py，CloudBase → Postgres) ----
# 仅全量迁移 V1.x CloudBase 集合时需要；无凭证可用 --dry-run / --only-alter。
CLOUDBASE_ENV_ID=
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
# 共享 Postgres 连接串（migrate_v1.py / reembed_v1.py 读取；缺省指向 docker 内 PG）。
SQLALCHEMY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/studymind

# ---- 迁移脚本运行参数（可选，脚本内也有缺省） ----
# reembed_v1.py 的 FastGPT 数据集名
REEMBED_DATASET_NAME=studymind_kb_v2
